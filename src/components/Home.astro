---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Listing from './Listing.astro';
import EntryBlock from './EntryBlock.astro';
import { site } from '../data/site';
import { profile } from '../data/profile';
import { worldOfKind, type WorldId } from '../data/worlds';

interface Props { world: WorldId }
const { world } = Astro.props;
const all = await getCollection('posts', (e) => !e.data.draft && worldOfKind(e.data.kind) === world);
const recent = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 5);
const links = profile.links.filter((l) => l.href);
---
<Base world={world}>
  {world === 'work' ? (
    <div class="profile">
      <section class="hero">
        <h1 class="headline">{profile.fullName}</h1>
        <p class="tagline">{profile.headline} · {profile.tagline}</p>
        <p class="summary">{profile.summary}</p>
        <p class="links">{profile.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}</p>
      </section>

      <section class="panel block">
        <h2>Projects</h2>
        {profile.projects.map((e) => <EntryBlock entry={e} />)}
      </section>

      <section class="panel block">
        <h2>Research</h2>
        {profile.research.map((e) => <EntryBlock entry={e} />)}
      </section>

      <section class="panel block">
        <h2>Experience</h2>
        {profile.experience.map((e) => <EntryBlock entry={e} />)}
      </section>

      <section class="panel block">
        <h2>Skills</h2>
        <dl class="skills">
          {profile.skills.map((g) => (<><dt>{g.group}</dt><dd>{g.items}</dd></>))}
        </dl>
      </section>

      {recent.length > 0 && (
        <section class="panel block">
          <h2>Writing</h2>
          <Listing entries={recent} kindTag summary={false} />
        </section>
      )}
    </div>
  ) : (
    <section class="home" id="home">
      <p class="bio">{site.bio.off}</p>
      {recent.length > 0 && <p class="cap">最近</p>}
      {recent.length > 0 && <Listing entries={recent} summary={false} />}
    </section>
  )}
</Base>

<style is:global>
  /* work 主页：简历式的一页，内容在实色面板里，背景只做氛围 */
  .profile { max-width: 900px; margin-top: 28px; display: flex; flex-direction: column; gap: 18px; padding-bottom: 20px; }
  .hero { padding: 6px 2px 10px; }
  .headline { font-weight: 400; font-size: clamp(30px, 5vw, 44px); letter-spacing: 0.06em; color: var(--ink); line-height: 1.2; }
  .tagline { margin-top: 4px; font-family: var(--font-pixel); font-size: 22px; letter-spacing: 0.06em; color: var(--accent); }
  .summary { margin-top: 12px; color: var(--ink); max-width: 68ch; line-height: 1.7; }
  .links { margin-top: 14px; display: flex; gap: 20px; font-family: var(--font-pixel); font-size: 20px; }
  .links a { color: var(--accent); border-bottom: 1px dashed var(--accent); }
  .block { max-width: none; }
  .block h2 { font-weight: 400; font-family: var(--font-pixel); font-size: 22px; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 12px; text-transform: uppercase; }
  .entry + .entry { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); }
  .entry header { display: flex; flex-wrap: wrap; gap: 0 12px; align-items: baseline; justify-content: space-between; }
  .entry h3 { font-weight: 400; font-size: 20px; color: var(--ink); line-height: 1.4; }
  .entry .period { font-family: var(--font-pixel); font-size: 18px; color: var(--ink-dim); white-space: nowrap; }
  .entry .role { color: var(--accent); font-size: 15px; margin-top: 2px; }
  .entry .intro { margin-top: 8px; color: var(--ink-dim); font-size: 16px; line-height: 1.6; }
  .entry .elinks { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px 16px; font-family: var(--font-pixel); font-size: 18px; }
  .entry .elinks a { color: var(--accent); border-bottom: 1px dashed var(--accent); }
  .entry ul { margin: 10px 0 0 1.2em; font-size: 16px; line-height: 1.65; }
  .entry li + li { margin-top: 6px; }
  .entry li strong { font-weight: 400; color: var(--accent); }
  .skills { display: grid; grid-template-columns: 110px 1fr; gap: 6px 14px; font-size: 16px; }
  .skills dt { font-family: var(--font-cjk); font-size: 15px; color: var(--ink-dim); }
  .block .listing { margin-top: 0; }
  .block .listing a { padding-left: 0; }
  @media (max-width: 560px) { .skills { grid-template-columns: 1fr; gap: 0; } .skills dd { margin-bottom: 8px; } }
</style>

<script>
  // off 面的首页：逐字打出一句话 (仅完整模式)；等标题卡淡出之后再开始
  async function run() {
    const home = document.getElementById('home');
    const el = home?.querySelector<HTMLElement>('.bio');
    if (!home || !el) return;
    const root = document.documentElement;
    const text = el.textContent || '';
    const calm = root.dataset.fx === 'calm' || matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (calm) { home.classList.add('on'); return; }

    el.textContent = '';
    let cancelled = false;
    document.addEventListener('astro:before-swap', () => { cancelled = true; }, { once: true });
    await (window as unknown as { __titleReady?: Promise<void> }).__titleReady;
    el.classList.add('blink');
    for (let i = 1; i <= text.length; i++) {
      if (cancelled) return;
      el.textContent = text.slice(0, i);
      await new Promise((r) => setTimeout(r, 30 + Math.random() * 30));
    }
    el.classList.remove('blink');
    home.classList.add('on');
  }
  document.addEventListener('astro:page-load', run);
</script>
