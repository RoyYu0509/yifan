---
import { tracks } from '../data/bgm';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = Object.fromEntries(
  Object.entries(tracks).map(([w, ts]) => [w, ts.map((t) => ({ title: t.title, src: `${base}/${t.src}` }))]),
);
---
<button class="bgm" id="bgm" type="button" aria-pressed="false" aria-label="toggle background music" transition:persist data-tracks={JSON.stringify(list)}>
  <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span id="bgm-label">♪ BGM OFF</span>
</button>

<script>
  const btn = document.getElementById('bgm') as HTMLButtonElement;
  const label = document.getElementById('bgm-label')!;
  const all: Record<string, { title: string; src: string }[]> = JSON.parse(btn.dataset.tracks || '{}');
  const worldNow = () => document.documentElement.dataset.world || 'work';

  let on = false;
  let playing = ''; // 当前正在放的世界
  let audio: HTMLAudioElement | null = null;
  let idx = 0;

  // ---- 没有 mp3 时的占位：WebAudio 合成 ambient ----
  // work：温暖、轻快、有一点希望的和弦 + 稀疏的柔和拨弦 (面向招聘方，不能冷)
  // off ：低频 pad + 钟声 (A 小调五声音阶)
  let ac: AudioContext | null = null;
  let master: GainNode | null = null;
  let timer: number | undefined;
  let chordTimer: number | undefined;

  const OFF_NOTES = [220, 261.63, 293.66, 329.63, 392, 440, 523.25, 587.33];
  const WORK_NOTES = [523.25, 587.33, 659.25, 783.99, 880, 1046.5]; // C 大调五声音阶
  // Cmaj7 → Am7 → Fmaj7 → G，每个和弦 8 秒
  const WORK_CHORDS = [
    [130.81, 196.0, 246.94, 329.63],
    [110.0, 164.81, 196.0, 261.63],
    [87.31, 174.61, 220.0, 329.63],
    [98.0, 196.0, 246.94, 293.66],
  ];

  function startSynth(world: string) {
    ac = new AudioContext();
    ac.resume();
    const ctx = ac;
    master = ctx.createGain();
    master.gain.value = 0;
    master.gain.linearRampToValueAtTime(world === 'off' ? 0.5 : 0.55, ctx.currentTime + 3);
    const lp = ctx.createBiquadFilter();
    lp.type = 'lowpass';
    lp.frequency.value = world === 'off' ? 900 : 1800;
    const delay = ctx.createDelay(1);
    delay.delayTime.value = world === 'off' ? 0.42 : 0.38;
    const fb = ctx.createGain();
    fb.gain.value = world === 'off' ? 0.45 : 0.38;
    delay.connect(fb).connect(delay);
    lp.connect(master);
    lp.connect(delay);
    delay.connect(master);
    master.connect(ctx.destination);

    if (world === 'off') {
      for (const [f, d] of [[55, 0], [82.41, 3], [110, -4]] as const) {
        const o = ctx.createOscillator();
        o.type = 'triangle';
        o.frequency.value = f;
        o.detune.value = d;
        const g = ctx.createGain();
        g.gain.value = 0.18;
        const lfo = ctx.createOscillator();
        lfo.frequency.value = 0.07 + Math.random() * 0.05;
        const lg = ctx.createGain();
        lg.gain.value = 0.08;
        lfo.connect(lg).connect(g.gain);
        o.connect(g).connect(lp);
        o.start();
        lfo.start();
      }
    } else {
      // 和弦 pad：慢起慢落，相邻和弦互相重叠
      let ci = 0;
      const chord = () => {
        if (!ac || ac !== ctx) return;
        const t0 = ctx.currentTime;
        for (const f of WORK_CHORDS[ci % WORK_CHORDS.length]) {
          const o = ctx.createOscillator();
          o.type = 'triangle';
          o.frequency.value = f;
          const g = ctx.createGain();
          g.gain.setValueAtTime(0, t0);
          g.gain.linearRampToValueAtTime(0.07, t0 + 2.5);
          g.gain.linearRampToValueAtTime(0.0001, t0 + 10);
          o.connect(g).connect(lp);
          o.start(t0);
          o.stop(t0 + 10.2);
        }
        ci++;
        chordTimer = window.setTimeout(chord, 8000);
      };
      chord();
    }

    const notes = world === 'off' ? OFF_NOTES : WORK_NOTES;
    const note = () => {
      if (!ac || ac !== ctx) return;
      const o = ctx.createOscillator();
      o.type = world === 'off' ? 'sine' : 'triangle';
      o.frequency.value = notes[(Math.random() * notes.length) | 0];
      const g = ctx.createGain();
      const t0 = ctx.currentTime;
      g.gain.setValueAtTime(0, t0);
      g.gain.linearRampToValueAtTime(world === 'off' ? 0.12 : 0.08, t0 + 0.015);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + (world === 'off' ? 4 : 2.2));
      o.connect(g).connect(lp);
      o.start(t0);
      o.stop(t0 + 4.2);
      timer = window.setTimeout(note, (world === 'off' ? 2500 : 1600) + Math.random() * (world === 'off' ? 4500 : 3200));
    };
    note();
  }

  function stopSynth() {
    clearTimeout(timer);
    clearTimeout(chordTimer);
    if (!ac || !master) return;
    const c = ac, m = master;
    m.gain.cancelScheduledValues(c.currentTime);
    m.gain.setValueAtTime(m.gain.value, c.currentTime);
    m.gain.linearRampToValueAtTime(0, c.currentTime + 0.8);
    setTimeout(() => c.close(), 1000);
    ac = null;
    master = null;
  }

  async function startFor(world: string) {
    playing = world;
    const list = all[world] || [];
    if (list.length) {
      audio ??= new Audio();
      audio.loop = list.length === 1;
      audio.volume = 0.5;
      audio.onended = () => { idx = (idx + 1) % list.length; audio!.src = list[idx].src; audio!.play(); setUI(); };
      idx = 0;
      audio.src = list[0].src;
      try { await audio.play(); } catch { on = false; }
    } else {
      startSynth(world);
    }
  }

  function stopCurrent() {
    audio?.pause();
    stopSynth();
  }

  function setUI() {
    btn.setAttribute('aria-pressed', String(on));
    const list = all[playing] || [];
    label.textContent = on ? `♪ BGM ON · ${list.length ? list[idx].title : 'ambient'}` : '♪ BGM OFF';
  }

  btn.addEventListener('click', async () => {
    on = !on;
    if (on) await startFor(worldNow());
    else stopCurrent();
    setUI();
  });

  // 换世界后，音乐跟着换
  document.addEventListener('astro:after-swap', () => {
    if (on && worldNow() !== playing) {
      stopCurrent();
      startFor(worldNow()).then(setUI);
    }
  });
</script>
