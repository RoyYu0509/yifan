---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { worldOfKind } from '../data/worlds';

interface Props { entry: CollectionEntry<'posts'> }
const { entry } = Astro.props;
const world = worldOfKind(entry.data.kind);
const { Content } = await render(entry);
---
<Base world={world} title={entry.data.title} description={entry.data.summary}>
  <article class="panel" style="margin-top: 28px;">
    <p class="meta"><span class="d">{entry.data.date.toISOString().slice(0, 10)}</span>{entry.data.tags.length ? ` · ${entry.data.tags.join(' · ')}` : ''}</p>
    <h1 class={world === 'off' ? 'shadow-title' : ''} data-scramble={world === 'work' ? entry.data.title : undefined}>{entry.data.title}</h1>
    <div class="prose" style="margin-top: 16px;"><Content /></div>
  </article>
</Base>
