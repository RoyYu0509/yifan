---
// 首页：背景场景 + 一块铺满屏幕 (四周留白) 的面板。
// 面板顶部是 tab：左边标题，右边导航，最右是展开/收起的箭头。
// 收起后只剩这条 tab，下面露出整座城市。进入任何一个栏目后就是没有背景的“房间”。
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getEntry, render } from 'astro:content';
import { visibleSections } from '../data/nav';
import { pathOf, type WorldId } from '../data/worlds';

interface Props { world: WorldId }
const { world } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = await visibleSections(world);
const showResume = world === 'work' && !!site.resume;
const entry = (await getEntry('home', world))!;
const { Content } = await render(entry);
const resumeHref = `${base}/${site.resume}`;
---
<Base world={world} view="landing">
  <section class="window" id="landing" aria-label="intro">
    <div class="bar">
      <span class="tab">~/{site.name.toLowerCase()}</span>
      <nav class="bar-nav" aria-label="pages">
        {sections.map((s) => <a href={`${base}${pathOf(world, s.slug)}`}>{s.label}</a>)}
        {showResume && <a href={resumeHref} download={site.resumeName} data-astro-reload>resume ↓</a>}
      </nav>
      <button class="win-toggle" type="button" aria-label="collapse panel" aria-expanded="true" title="展开 / 收起">
        <svg class="up" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10 L8 5 L13 10" /></svg>
        <svg class="down" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6 L8 11 L13 6" /></svg>
      </button>
    </div>

    <!-- 面板里的文字来自 src/content/home/<world>.md，直接用 Markdown 写 -->
    <div class="win-body">
      <div class="md"><Content /></div>
    </div>
  </section>
</Base>
<noscript><style>.window { opacity: 1 !important; transform: none !important; } </style></noscript>

<script>
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setCollapsed(on: boolean) {
    if (on) root.dataset.box = 'closed';
    else delete root.dataset.box;
    document.querySelector('.win-toggle')?.setAttribute('aria-expanded', String(!on));
  }

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.win-toggle')) setCollapsed(root.dataset.box !== 'closed');
  });
  document.addEventListener('astro:after-swap', () => delete root.dataset.box);

  async function init() {
    const win = document.getElementById('landing');
    if (!win || win.dataset.init) return;
    win.dataset.init = '1';
    let landed = false;
    try { landed = !!sessionStorage.getItem('landed'); } catch {}
    if (landed || reduce) { win.classList.add('open', 'instant', 'done'); return; }
    await (window as unknown as { __titleReady?: Promise<void> }).__titleReady; // 等标题卡退场，面板再浮出来
    win.classList.add('open', 'done');
    try { sessionStorage.setItem('landed', '1'); } catch {}
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
