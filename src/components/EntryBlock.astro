---
import type { Entry } from '../data/profile';
interface Props { entry: Entry }
const { entry } = Astro.props;
---
<article class="entry">
  <header>
    <h3>{entry.title}</h3>
    <span class="period">{entry.period}</span>
  </header>
  {entry.role && <p class="role">{entry.role}</p>}
  {entry.intro && <p class="intro">{entry.intro}</p>}
  {entry.links && entry.links.length > 0 && (
    <p class="elinks">{entry.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}</p>
  )}
  <ul>
    {entry.bullets.map((b) => <li><strong>{b.lead}</strong>：{b.text}</li>)}
  </ul>
</article>
