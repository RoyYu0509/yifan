---
import Section from '../../components/Section.astro';
import { profile } from '../../data/profile';
---
<Section world="work" slug="about">
  <h3 class="sub">Education</h3>
  {profile.education.map((e) => (
    <article class="edu">
      <header><strong>{e.school}</strong><span class="period">{e.period}</span></header>
      <p class="degree">{e.degree}</p>
      <ul>{e.notes.map((n) => <li>{n}</li>)}</ul>
      <p class="courses"><span class="dim">专业课程：</span>{e.courses}</p>
    </article>
  ))}

  <h3 class="sub">Publications</h3>
  <ol class="pubs">
    {profile.publications.map((p) => (
      <li>{p.text} <em>{p.href ? <a href={p.href} rel="noopener">{p.venue}</a> : p.venue}</em></li>
    ))}
  </ol>

  <h3 class="sub">Contact</h3>
  <p class="links2">{profile.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}</p>
</Section>

<style is:global>
  .prose .sub { margin-top: 26px; }
  .prose .sub:first-child { margin-top: 4px; }
  .edu { margin-top: 12px; }
  .edu header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 12px; align-items: baseline; }
  .edu .period { font-family: var(--font-pixel); color: var(--ink-dim); font-size: 18px; }
  .edu .degree { color: var(--accent); font-size: 15px; }
  .edu .courses { margin-top: 4px; font-size: 15px; color: var(--ink); }
  .pubs { padding-left: 1.4em; }
  .pubs li + li { margin-top: 8px; }
  .links2 { display: flex; gap: 20px; font-family: var(--font-pixel); font-size: 20px; }
  .prose.wide { max-width: none; }
</style>
