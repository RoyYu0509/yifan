---
import Base from '../layouts/Base.astro';
import { homeOf } from '../data/worlds';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base world="off" title="404">
  <section class="panel" style="margin-top: 28px;">
    <a class="back" href={`${base}${homeOf('work')}`}>← 返回</a>
    <p class="path">404</p>
    <h1 class="shadow-title">这里没有路。</h1>
    <p class="dim">墙很高，门已经关上了。</p>
    <p style="margin-top: 14px;"><a href={`${base}${homeOf('work')}`} style="color: var(--accent); border-bottom: 1px dashed var(--accent);">回到首页</a></p>
  </section>
</Base>
