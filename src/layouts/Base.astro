---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/vt323/400.css';
import '@fontsource/dotgothic16/400.css';
import '../styles/global.css';
import Scene from '../components/Scene.astro';
import TitleCard from '../components/TitleCard.astro';
import BgmPlayer from '../components/BgmPlayer.astro';
import FxToggle from '../components/FxToggle.astro';
import { site } from '../data/site';
import { worlds, homeOf, pathOf, type WorldId } from '../data/worlds';
import { visibleSections } from '../data/nav';

interface Props {
  world: WorldId;
  view?: 'landing' | 'room'; // landing：背景 + 面板；room：进入页面后的纯阅读排版
  title?: string;
  description?: string;
}
const { world, view = 'room', title, description = `${site.name} — ${site.bio.work}` } = Astro.props;
const w = worlds[world];
const other = w.other;
const navSections = await visibleSections(world);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.sub[world]}`;
---
<!doctype html>
<html lang="zh-CN" data-world={world} data-view={view}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070c" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{fullTitle}</title>
    <ClientRouter />
    <!-- 视觉强度：calm (安静) / full (完整)。work 默认 calm，off 默认 full，访客可以自己切换并记住 -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        var apply = function () {
          var pref = null;
          try { pref = localStorage.getItem('fx'); } catch (e) {}
          var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          r.dataset.fx = reduced ? 'calm' : pref || (r.dataset.world === 'off' ? 'full' : 'calm');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        try { if (sessionStorage.getItem('intro')) r.dataset.intro = 'skip'; } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Scene />
    <!-- 画面里的入口：位置在 global.css 里按世界设定，平时完全不可见 -->
    <button
      class="portal"
      type="button"
      data-shuffle={`${base}${homeOf(other)}`}
      aria-label={other === 'off' ? 'after hours' : 'back to work'}
    ></button>

    <div class="fx fx-grain" aria-hidden="true"></div>
    <div class="fx fx-scan" aria-hidden="true"></div>
    <div class="fx fx-vignette" aria-hidden="true"></div>
    <div class="fx fx-lantern" aria-hidden="true"></div>

    <div class="shell">
      {view === 'room' && (
      <header class="topbar">
        <a class="world-label" href={`${base}${homeOf(world)}`}>
          <span class="zh">{site.name}</span>
          <span class="en">{site.sub[world]}</span>
        </a>
        <nav class="nav">
          {navSections.map((s) => <a href={`${base}${pathOf(world, s.slug)}`}>{s.label}</a>)}
          {world === 'work' && site.resume && <a href={`${base}/${site.resume}`} download={site.resumeName} data-astro-reload>resume ↓</a>}
        </nav>
      </header>
      )}

      <main>
        <slot />
      </main>

      <footer class="footbar">
        <span class="copy">© {new Date().getFullYear()} {site.name}</span>
        <span class="controls">
          {view === 'landing' && <FxToggle />}
          <BgmPlayer />
        </span>
      </footer>
    </div>

    <TitleCard world={world} />

    <script>
      const root = document.documentElement;

      // 手电光 + off 里标题的 text-shadow：两者都挂在 <html> 的 CSS 变量上，body 被 swap 后依然有效
      let nx = 0, ny = 0, sx = 0, sy = 0;
      window.addEventListener(
        'pointermove',
        (e) => {
          root.style.setProperty('--mx', e.clientX + 'px');
          root.style.setProperty('--my', e.clientY + 'px');
          nx = e.clientX / innerWidth - 0.5;
          ny = e.clientY / innerHeight - 0.5;
        },
        { passive: true },
      );
      (function tick() {
        sx += (-nx * 18 - sx) * 0.05; // 慢半拍地追上
        sy += (3 + -ny * 8 - sy) * 0.05;
        root.style.setProperty('--sx', sx.toFixed(1) + 'px');
        root.style.setProperty('--sy', sy.toFixed(1) + 'px');
        requestAnimationFrame(tick);
      })();

      // 入口的悬停 / 聚焦反馈 (由 scene 读取 data-hot)
      const hot = (on: boolean) => (e: Event) => {
        if ((e.target as HTMLElement).closest?.('.portal')) {
          if (on) root.dataset.hot = '1';
          else delete root.dataset.hot;
        }
      };
      document.addEventListener('pointerover', hot(true));
      document.addEventListener('pointerout', hot(false));
      document.addEventListener('focusin', hot(true));
      document.addEventListener('focusout', hot(false));
      document.addEventListener('astro:before-swap', () => delete root.dataset.hot);

      // Markdown 里指向本站的链接 / 图片可以直接写成 /xxx：这里补上 base (项目站点的 /<repo> 前缀)；
      // 指向 .pdf 的链接设为点击即下载。
      const prefix = import.meta.env.BASE_URL.replace(/\/$/, '');
      function fixMarkdownLinks() {
        // 邮箱只当文字显示 (很多人没有配置邮件客户端，点了没有反应)，不做成 mailto 链接
        document.querySelectorAll<HTMLAnchorElement>('.md a[href^="mailto:"], .prose a[href^="mailto:"]').forEach((a) => {
          const sp = document.createElement('span');
          sp.className = 'mail';
          sp.textContent = a.textContent;
          a.replaceWith(sp);
        });
        document.querySelectorAll<HTMLAnchorElement>('.md a[href^="/"], .prose a[href^="/"]').forEach((a) => {
          let h = a.getAttribute('href')!;
          if (h.startsWith('//')) return;
          if (prefix && !h.startsWith(prefix + '/')) { h = prefix + h; a.setAttribute('href', h); }
          if (/\.pdf$/i.test(h.split('?')[0])) {
            a.setAttribute('download', /(^|\/)resume\.pdf$/i.test(h) ? 'Yifan_Yu_Resume.pdf' : '');
            a.setAttribute('data-astro-reload', '');
          }
        });
        document.querySelectorAll<HTMLImageElement>('.md img[src^="/"], .prose img[src^="/"]').forEach((im) => {
          const s = im.getAttribute('src')!;
          if (!s.startsWith('//') && prefix && !s.startsWith(prefix + '/')) im.setAttribute('src', prefix + s);
        });
      }
      document.addEventListener('astro:page-load', fixMarkdownLinks);
      fixMarkdownLinks();

      console.log('%c墙很高，门已经关上了。', 'color:#e8d9a8');
    </script>
  </body>
</html>
